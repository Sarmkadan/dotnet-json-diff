<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>JsonDiff</PackageId>
    <Version>0.2.0</Version>
    <Authors>Vladyslav Zaiets</Authors>
    <Description>Semantic JSON diff, patch, and merge-patch generation for .NET: compares two JSON documents ignoring key order and emits Added/Removed/Changed paths as JSON Patch (RFC 6902) or JSON Merge Patch (RFC 7386).</Description>
    <PackageTags>json;diff;patch;merge;jsonpatch</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Sarmkadan/dotnet-json-diff</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
